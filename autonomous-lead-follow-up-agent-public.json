    {
      "parameters": {
        "jsCode": "\nconst leads = $input.all().map(item => item.json);\n\n// Rank leads from highest to lowest score\nleads.sort((a, b) => Number(b.lead_score) - Number(a.lead_score));\n\nconst followUpCount = leads.filter(\n  lead => lead.decision === \"Follow-up recommended\"\n).length;\n\nconst skippedCount = leads.length - followUpCount;\n\nreturn [\n  {\n    json: {\n      total_leads: leads.length,\n      follow_up_count: followUpCount,\n      skipped_count: skippedCount,\n      ranked_leads: leads\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2128,
        416
      ],
