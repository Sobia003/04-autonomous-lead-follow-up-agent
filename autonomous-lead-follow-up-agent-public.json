      ],
      "id": "12594dd0-2fb9-47cc-bdc9-fbb9cf8af84c",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.name + \" | \" + $json.email + \" | \" + $json.company + \" | \" + ($json.message || \"Not provided\") + \" | \" + ($json.budget || \"Not provided\") + \" | \" + $json.status + \" | Verification status: \" + $json.verification_status + \" | Verification reason: \" + $json.verification_reason }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an autonomous lead follow-up decision agent working with existing HubSpot contacts.\n\nEvaluate the contact details provided in the user message.\n\nRules:\n1. Assign a lead score from 0 to 100 based only on available evidence.\n2. Classify priority as High, Medium, or Low.\n3. Decide whether follow-up is recommended.\n4. Explain the decision using evidence from the contact information.\n5. Recommend one practical next action.\n6. Identify missing information without inventing details.\n7. Do not assume an existing contact is an interested buyer.\n8. If the message and budget are missing, do not assume business or purchase intent.\n9. Set recommended_action_type to exactly one of: \"Send Follow-up\", \"Request Information\", \"No Action\", or \"Review Contact\".\n10. If follow-up is not recommended, do not recommend sending a follow-up email. Recommend reviewing the contact or waiting for more information instead.\n11. If follow-up is recommended, provide a short, professional, personalized email draft.\n12. Never send emails, modify HubSpot records, or perform external actions.\n\nReturn the result using the exact JSON structure required by the connected Structured Output Parser.\n\n13. Consider verification_status and verification_reason when making a recommendation. If required contact information is missing or there is a significant data inconsistency, recommend \"Review Contact\". Do not claim that a contact's identity is verified merely because their name and email are present."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        880,
        416
      ],
      "id": "fa457b32-b456-4d4c-9a14-7b7e3e2ca09f",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
